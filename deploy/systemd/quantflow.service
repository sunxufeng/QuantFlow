[Unit]
Description=QuantFlow FastAPI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/quantflow/QuantFlow/backend
Environment=QF_DEBUG=0
Environment=QF_CORS_ORIGINS=http://localhost:8080
ExecStart=/opt/quantflow/QuantFlow/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
